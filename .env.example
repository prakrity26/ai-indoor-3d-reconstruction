# Application
LOG_LEVEL=INFO

# API and web platform (python -m api → http://API_HOST:API_PORT/)
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL. Compose builds DATABASE_URL for its containers from these three values.
POSTGRES_USER=reconstruction
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconstruction
# Laptop default is SQLite at data/jobs/index.sqlite when DATABASE_URL is empty.
# Postgres from Compose:
# DATABASE_URL=postgresql://reconstruction:change-me@localhost:5432/reconstruction
DATABASE_URL=

# Redis (optional wake-up for workers)
# Redis is optional. Empty means the worker polls the SQLite job table.
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Artifact paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
OUTPUT_DIR=./data/outputs

# Compute device: auto | mps | cuda | cpu
# Apple Silicon development uses auto → MPS, then CPU fallback.
# Production NVIDIA hosts can set cuda when available.
COMPUTE_DEVICE=auto

# Upload limits
MAX_UPLOAD_MB=500

# Worker: fail jobs whose progress has not changed for this long (crashed / killed worker)
WORKER_STALE_MINUTES=180

# Phase 1 — video validation and uniform frame extraction
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm,.m4v
MIN_VIDEO_WIDTH=320
MIN_VIDEO_HEIGHT=240
MIN_DURATION_SEC=1
MAX_DURATION_SEC=600
MIN_FPS=5
TARGET_EXTRACT_FPS=5
MAX_EXTRACTED_FRAMES=400
FRAME_JPEG_QUALITY=95
QUALITY_SAMPLE_COUNT=12
DARK_MEAN_THRESHOLD=12
BRIGHT_MEAN_THRESHOLD=245
BLUR_LAPLACIAN_THRESHOLD=20

# Phase 2 — adaptive keyframe selection
KEYFRAME_MIN_COUNT=8
KEYFRAME_MAX_COUNT=120
KEYFRAME_MIN_GAP=1
KEYFRAME_MAX_GAP=8
KEYFRAME_DIFF_THRESHOLD=0.08
KEYFRAME_THUMBNAIL_SIZE=64
KEYFRAME_SHARPNESS_WIDTH=320

# Phase 3 — monocular camera pose (OpenCV ORB + essential matrix)
POSE_FOCAL_SCALE=1.2
# Optional calibrated intrinsics; leave blank to use POSE_FOCAL_SCALE and image size
POSE_FX=
POSE_FY=
POSE_CX=
POSE_CY=
POSE_ORB_FEATURES=2000
POSE_RATIO_TEST=0.75
POSE_RANSAC_THRESH=1.0
POSE_MIN_MATCHES=40
POSE_MIN_INLIERS=20
POSE_MAX_PAIR_SKIP=2

# Phase 4 — monocular depth (your local video; not a Hugging Face clip)
# First run may download Depth Anything V2 Small weights only.
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_LOCAL_FILES_ONLY=0
DEPTH_MAX_SIZE=768
DEPTH_WRITE_PREVIEW=1

# Phase 5 — initial point cloud (back-project posed depth; not Open3D fusion)
CLOUD_STRIDE=8
CLOUD_MIN_DEPTH=0.05
CLOUD_MAX_DEPTH=20
CLOUD_MEDIAN_TARGET=1.0
CLOUD_MAX_POINTS=400000

# Phase 6 — filter and voxel-fuse the Phase 5 cloud (Open3D)
CLOUD_FILTER_NB_NEIGHBORS=20
CLOUD_FILTER_STD_RATIO=2.0
CLOUD_VOXEL_SIZE=0.02
CLOUD_CROP_PERCENTILE=1.0
CLOUD_FILTER_MIN_POINTS=100

# Phase 7 — Poisson mesh + GLB/PLY from the filtered cloud (Open3D)
MESH_POISSON_DEPTH=8
# 1 avoids an intermittent Open3D Poisson segfault on macOS; -1 = auto threads.
MESH_POISSON_THREADS=1
MESH_NORMAL_RADIUS=0.05
MESH_NORMAL_MAX_NN=30
MESH_ORIENT_K=15
MESH_DENSITY_QUANTILE=0.02
MESH_BBOX_SCALE=1.1
MESH_MIN_TRIANGLES=50
MESH_MAX_TRIANGLES=200000
MESH_WRITE_GLB=1

# Phase 8 — object labels on keyframes. 3D positions need Phases 3–4.
# First run with .[detect] may download the small YOLOv8n weights.
SCENE_CONFIDENCE=0.35
SCENE_MAX_FRAMES=40
SCENE_MODEL=yolov8n.pt
SCENE_MERGE_DISTANCE=0.6
SCENE_DEVICE=cpu

# In-repo gsplat trainer (SPLAT_BACKEND=gsplat, experimental). Splatfacto settings are below.
SPLAT_EXTRACT_FPS=8
SPLAT_MAX_FRAMES=250
SPLAT_IMAGE_MAX_SIZE=1280
SPLAT_COLMAP_BIN=colmap

# ---- Photoreal splats on a remote GPU (Colab) ---------------------------------------------
# Shared secret between python -m api.worker_gateway and the GPU worker. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_TOKEN=
WORKER_GATEWAY_PORT=8001
# A running splat with no progress for this long is marked failed (Colab disconnects).
SPLAT_STALE_MINUTES=20
SPLAT_MAX_UPLOAD_MB=3000
# GPU worker side: splatfacto (Nerfstudio, default) or gsplat (in-repo trainer)
SPLAT_BACKEND=splatfacto
# Frames sampled from the video for COLMAP. 300 gives enough overlap for a room walk-through.
SPLAT_NUM_FRAMES=300
# 30000 is full quality (~20 min on an RTX 4090); 7000 is a quick preview.
SPLAT_TRAIN_STEPS=30000
# Frames are shrunk to this long side before COLMAP; training never needs more.
SPLAT_MAX_SIDE=1600
SPLAT_MIN_BYTES=5000000
# Stop before training when COLMAP places fewer than this share of the frames.
SPLAT_MIN_REGISTERED=0.3
# COLMAP threads. Empty = the CPUs this container may use (≤ 16). Rented pods see every host
# core, and one SIFT thread per core runs them out of memory.
SPLAT_COLMAP_THREADS=
