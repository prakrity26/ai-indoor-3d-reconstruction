# Application
APP_ENV=development
APP_NAME=ai-indoor-3d-reconstruction
LOG_LEVEL=INFO

# API (FastAPI — implemented in a later phase)
API_HOST=0.0.0.0
API_PORT=8000

# UI (Streamlit — implemented in a later phase)
UI_HOST=0.0.0.0
UI_PORT=8501

# PostgreSQL (service skeleton only in Phase 0)
POSTGRES_USER=reconstruction
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconstruction
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reconstruction:change-me@postgres:5432/reconstruction

# Redis (service skeleton only in Phase 0)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Artifact paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
OUTPUT_DIR=./data/outputs

# Compute device: auto | mps | cuda | cpu
# Apple Silicon development uses auto → MPS, then CPU fallback.
# Production NVIDIA hosts can set cuda when available.
COMPUTE_DEVICE=auto

# Upload limits
MAX_UPLOAD_MB=500

# Phase 1 — video validation and uniform frame extraction
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm,.m4v
MIN_VIDEO_WIDTH=320
MIN_VIDEO_HEIGHT=240
MIN_DURATION_SEC=1
MAX_DURATION_SEC=600
MIN_FPS=5
TARGET_EXTRACT_FPS=5
MAX_EXTRACTED_FRAMES=400
FRAME_JPEG_QUALITY=95
QUALITY_SAMPLE_COUNT=12
DARK_MEAN_THRESHOLD=12
BRIGHT_MEAN_THRESHOLD=245
BLUR_LAPLACIAN_THRESHOLD=20
