# Application
APP_ENV=development
APP_NAME=ai-indoor-3d-reconstruction
LOG_LEVEL=INFO

# API (FastAPI — implemented in a later phase)
API_HOST=0.0.0.0
API_PORT=8000

# UI (Streamlit — implemented in a later phase)
UI_HOST=0.0.0.0
UI_PORT=8501

# PostgreSQL (service skeleton only in Phase 0)
POSTGRES_USER=reconstruction
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconstruction
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reconstruction:change-me@postgres:5432/reconstruction

# Redis (service skeleton only in Phase 0)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Artifact paths
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
OUTPUT_DIR=./data/outputs

# Compute device: auto | mps | cuda | cpu
# Apple Silicon development uses auto → MPS, then CPU fallback.
# Production NVIDIA hosts can set cuda when available.
COMPUTE_DEVICE=auto

# Upload limits
MAX_UPLOAD_MB=500

# Phase 1 — video validation and uniform frame extraction
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv,.webm,.m4v
MIN_VIDEO_WIDTH=320
MIN_VIDEO_HEIGHT=240
MIN_DURATION_SEC=1
MAX_DURATION_SEC=600
MIN_FPS=5
TARGET_EXTRACT_FPS=5
MAX_EXTRACTED_FRAMES=400
FRAME_JPEG_QUALITY=95
QUALITY_SAMPLE_COUNT=12
DARK_MEAN_THRESHOLD=12
BRIGHT_MEAN_THRESHOLD=245
BLUR_LAPLACIAN_THRESHOLD=20

# Phase 2 — adaptive keyframe selection
KEYFRAME_MIN_COUNT=8
KEYFRAME_MAX_COUNT=120
KEYFRAME_MIN_GAP=1
KEYFRAME_MAX_GAP=8
KEYFRAME_DIFF_THRESHOLD=0.08
KEYFRAME_THUMBNAIL_SIZE=64
KEYFRAME_SHARPNESS_WIDTH=320

# Phase 3 — monocular camera pose (OpenCV ORB + essential matrix)
POSE_FOCAL_SCALE=1.2
# Optional calibrated intrinsics; leave blank to use POSE_FOCAL_SCALE and image size
POSE_FX=
POSE_FY=
POSE_CX=
POSE_CY=
POSE_ORB_FEATURES=2000
POSE_RATIO_TEST=0.75
POSE_RANSAC_THRESH=1.0
POSE_MIN_MATCHES=40
POSE_MIN_INLIERS=20
POSE_MAX_PAIR_SKIP=2

# Phase 4 — monocular depth (your local video; not a Hugging Face clip)
# First run may download Depth Anything V2 Small weights only.
DEPTH_MODEL_ID=depth-anything/Depth-Anything-V2-Small-hf
DEPTH_LOCAL_FILES_ONLY=0
DEPTH_MAX_SIZE=768
DEPTH_WRITE_PREVIEW=1

# Phase 5 — initial point cloud (back-project posed depth; not Open3D fusion)
CLOUD_STRIDE=8
CLOUD_MIN_DEPTH=0.05
CLOUD_MAX_DEPTH=20
CLOUD_MEDIAN_TARGET=1.0
CLOUD_MAX_POINTS=400000
